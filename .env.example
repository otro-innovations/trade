# ── OTRO domain-portability engine (see src/lib/siteConfig.ts) ──────────────
# THE single place the production base domain is set. Migration otro.bd -> otro.cn
# = change this ONE value in Vercel project env + flip DNS. Never hardcode elsewhere.
NEXT_PUBLIC_BASE_DOMAIN=otro.bd

# Site identity (overridden per-repo in src/lib/siteConfig.ts defaults)
NEXT_PUBLIC_SITE_SUBDOMAIN=trade

# Contact / integrations (non-secret defaults live in siteConfig.ts)
NEXT_PUBLIC_CONTACT_EMAIL=sourcing@otro.bd

# ── Secrets are NEVER committed. Set these only in Vercel Environment Variables ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
